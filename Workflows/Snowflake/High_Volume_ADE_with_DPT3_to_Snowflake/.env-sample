# ---- LandingAI ADE (DPT-3) ----
# Get a key at https://va.landing.ai/settings/api-key
VISION_AGENT_API_KEY=your_ade_api_key_here

# ---- Snowflake (RSA key-pair auth) ----
SNOWFLAKE_USER=MACHINE_USER
SNOWFLAKE_ACCOUNT_IDENTIFIER=YOUR_ORG-YOUR_ACCOUNT
PRIVATE_KEY_FILE=/absolute/path/to/rsa_key.p8
ROLE=ADE_DEMOS
WAREHOUSE=ADE_WH
DATABASE=ADE_DEMO
SNOWFLAKE_SCHEMA=INVOICES

# ---- Throughput knobs ----
# Parallel documents in flight (parse+extract). Tune to your warehouse + rate limits.
MAX_WORKERS=16
# Parse and extract use SEPARATE model namespaces. Pin dated snapshots in prod.
PARSE_MODEL=dpt-3-pro-latest
EXTRACT_MODEL=extract-latest
