    "key_findings": [
      {
        "references": [
          "8ca8cfae-2197-413f-a480-4e3cfd5eddd1"
        ],
        "value": "Common cold infections are mostly transmitted through hand-to-hand contact, not droplet spread. Children experience up to 5 colds annually, and adults 2-3, causing discomfort and time off work/school; most symptoms resolve within a week, but coughs often last longer."
      },
      {
        "references": [
          "8ca8cfae-2197-413f-a480-4e3cfd5eddd1",
          "9046af80-5d95-45ba-8a08-d44006512893"
        ],
        "value": "Nasal and oral decongestants provide short-term (3-10 hours) relief of nasal congestion, but their long-term effectiveness (>10 hours) is unknown."
      },
      {
        "references": [
          "8ca8cfae-2197-413f-a480-4e3cfd5eddd1",
          "0656950f-6365-4ad9-81c5-d5f70785811b"
        ],
        "value": "Antibiotics are generally ineffective for common cold symptoms, can cause adverse effects, and contribute to antibiotic resistance. They may only be beneficial in specific cases of bacterial co-infection, which are hard to identify."
      },
      {
        "references": [
          "8ca8cfae-2197-413f-a480-4e3cfd5eddd1",
          "770107d1-4ed1-4773-aa9f-f344b1df8724"
        ],
        "value": "Vitamin C is unlikely to reduce the duration or severity of cold symptoms."
      },
      {
        "references": [
          "8ca8cfae-2197-413f-a480-4e3cfd5eddd1",
          "9046af80-5d95-45ba-8a08-d44006512893"
        ],
        "value": "The effectiveness of zinc gel or lozenges, echinacea, steam inhalation, and analgesics/anti-inflammatory drugs in reducing cold symptom duration is unknown."
