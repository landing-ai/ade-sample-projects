{
  "extraction": {
    "title": "Evaluation of echinacea for the prevention and treatment of the common cold: a meta-analysis",
    "authors": [
      "Sachin A Shah",
      "Stephen Sander",
      "C Michael White",
      "Mike Rinaldi",
      "Craig I Coleman"
    ],
    "publication_year": 2007,
    "study_type": "meta-analysis",
    "interventions_studied": [
      "echinacea",
      "Echinaguard",
      "Echinacin",
      "Echinacea angustifolia",
      "Echinacea pallida",
      "Echinacea purpurea",
      "Vitamin C",
      "propolis",
      "Thyme",
      "peppermint",
      "citric acid",
      "Lemongrass leaf",
      "spearmint",
      "rosemary leaf",
      "eucalyptus",
      "fennel seed"
    ],
    "sample_size": 1630,
    "key_findings": [
      "Echinacea significantly decreased the odds of developing the common cold by 58% (OR 0.42; 95% CI 0.25\u20130.71).",
      "Echinacea significantly reduced the duration of the common cold by 1.4 days (WMD -1.44, -2.24 to -0.64).",
      "These significant reductions in incidence and duration were maintained across various subgroup and sensitivity analyses, including those for specific echinacea products, concomitant supplement use, and method of cold exposure.",
      "No significant publication bias was detected by the Egger weighted regression statistic for either incidence or duration analyses, despite some asymmetry in funnel plots.",
      "The meta-analysis suggests that echinacea has a benefit in decreasing both the incidence and duration of the common cold, although large-scale prospective studies are still needed."
    ],
    "conclusion": "An analysis of the current evidence in the literature suggests that echinacea has a benefit in decreasing the incidence and duration of the common cold; however, large-scale randomised prospective studies controlling for variables such as species, quality of preparation and dose of echinacea, method of cold induction, and objectivity of study endpoints evaluated are needed before echinacea for the prevention or treatment of the common cold can become standard practice."
  },
