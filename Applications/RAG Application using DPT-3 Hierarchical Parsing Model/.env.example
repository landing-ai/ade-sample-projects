# Copy this file to .env and fill in your own keys.
#
#     cp .env.example .env

# DPT-3 Parse API key.
# Get one at https://va.landing.ai/settings/api-key
VISION_AGENT_API_KEY=pat_your_key_here

# Anthropic API key for the Q&A LLM.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your_key_here

# Optional: override the default Claude model
# ANTHROPIC_MODEL=claude-sonnet-4-6
